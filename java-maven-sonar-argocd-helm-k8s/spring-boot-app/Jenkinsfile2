pipeline {
  agent  {
    docker {
      image 'abhishekf5/maven-abhishek-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock' //mount docker socket to access the host machines docoker daemon
      //Docker Daemon Socket (docker.sock).It is not a regular text file or a folder; it is a live communications pipeline
      //(a Unix domain socket) that acts as the entry door to your host computer's Docker engine.
    }
  }
  stages {
    stage('Checkout') {
      steps
      {
        echo 'echo passed'
        git branch:'main', url:'https://github.com/Vageesh1998/Jenkins-Zero-To-Hero.git'
      }
    }
    stage('Build and test') {
      steps {
      sh 'ls -ltr'
      //build the project and create the JAR(Java archive file)
      sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
    }
  }
    stage('Static code analysis') {
       /* environment {
         SONAR_URL= "http://localhost:9090"
       } */
    steps {
      withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_AUTH_TOKEN')]) {
sh "cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.1.2184:sonar -Dsonar.token=${SONAR_AUTH_TOKEN} -Dsonar.host.url=http://host.docker.internal:9000"
      }
    }
}
   stage('Build image and push the image') {
   environment  {
    DOCKER_IMAGE= "abhishekf5/ultimate-cicd:${BUILD_NUMBER}"
    REGISTRY_CREDENTIALS= credentials('dockerhub-credentials')
   }
   steps {
     script {
       sh 'cd java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
       def dockerImage= docker.image("${DOCKER_IMAGE}")
       docker.withRegistry('https://index.docker.io/v1/', REGISTRY_CREDENTIALS) {
         dockerImage.push()
       }
     }
   }
    }
     stage('Update the deployment manifest') {
        environment {
            GIT_REPO_NAME = "Jenkins-Zero-To-Hero"
            GIT_USER_NAME = "Vageesh1998"
        }
       steps
       {
         withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                        sh """
                        git config user.email "302735558+Vageesh1998@users.noreply.github.com" 
                        git config user.name "Vageesh1998"
                        BUILD_NUMBER=${BUILD_NUMBER}
                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                         git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                      git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                     git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main
                """
         }
       }
     }
     }                 
      }   
       
      
